% ==========================================================
% harmonikabau_preamble.sty
% Einheitliche Präambel — direkt im Kindle-6×9-Format
% Kein Skalieren nötig: LaTeX setzt direkt auf 6×9 Zoll
% Schrift: DejaVu Sans | Compiler: xelatex
% ==========================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{harmonikabau_preamble}[2025/01/01 Harmonikabau 6x9]

% --- Schrift ---
\RequirePackage{fontspec}
\setmainfont{DejaVu Sans}
\setsansfont{DejaVu Sans}
\setmonofont{DejaVu Sans Mono}
\defaultfontfeatures{Ligatures=TeX}

% --- Sprache ---
\RequirePackage{polyglossia}
\setmainlanguage[spelling=new]{german}

% --- Mathematik ---
\RequirePackage{amsmath,amssymb}
\RequirePackage{siunitx}
\sisetup{locale=DE, per-mode=fraction}

% --- Seitenlayout: direkt 6×9 Zoll mit KDP-konformen Rändern ---
\RequirePackage{geometry}
\geometry{
  paperwidth  = 6in,
  paperheight = 9in,
  % oneside: gleicher Bundsteg (links) auf allen Seiten
  % KDP für 151-400 Seiten: Bundsteg >= 0.75'', Außen >= 0.25''
  left        = 19.1mm,   % Bundsteg ungerade Seiten (KDP 0.75'' fuer 151-400 S.)
  right       = 12.7mm,   % Bundsteg gerade Seiten (KDP 0.5'' Minimum fuer 186 S.)
  % includeheadfoot=false (default): top/bottom sind Textbereich-Ränder
  % Kopf-/Fußzeile liegen INNERHALB dieser Ränder → top muss groß genug sein
  % Kopfzeile: top - headheight - headsep muss >= 6.35mm = 18pt vom Blattrand
  % Bei headheight=10pt, headsep=3mm=8.5pt: top >= 18+10+8.5 = 36.5pt = 12.9mm
  % Fußzeile: bottom - footskip muss >= 18pt
  % Bei footskip=4mm=11.3pt: bottom >= 18+11.3 = 29.3pt = 10.3mm
  top         = 14mm,     % Sicherheitspuffer: Kopfzeile >= 0.25'' vom Rand
  bottom      = 14mm,     % Sicherheitspuffer: Fußzeile >= 0.25'' vom Rand
  headheight  = 10pt,
  headsep     = 3mm,
  footskip    = 4mm
}
% Textbreite um 2pt reduzieren: verhindert sub-pixel Rundungsfehler
% die KDP als Randverstoß erkennt (LaTeX-Gleitkomma: x1=396.03pt statt 396.00pt)
\addtolength{\textwidth}{-2pt}

% --- Tabellen ---
\RequirePackage{booktabs}
\RequirePackage{colortbl}
% Alle 	oprule-Zeilen bekommen automatisch hellblauen Hintergrund:
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}

% --- Grafik & Farbe ---
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{float}

% --- Listen ---
\RequirePackage{enumitem}
\setlist[itemize]{topsep=2pt, itemsep=1pt, parsep=0pt}
\setlist[enumerate]{topsep=2pt, itemsep=1pt, parsep=0pt}

% --- Boxen ---
\RequirePackage[many]{tcolorbox}

% --- Links ---
\RequirePackage{hyperref}
\hypersetup{hidelinks, colorlinks=false}

% --- Zeilenumbruch verbessern (verhindert Overfull-hbox) ---
\sloppy

% ============================================================
% Farben
% ============================================================
\definecolor{hb@headbg}{HTML}{dce8f5} % Hellblau Tabellenkopf
\definecolor{hb@blue}{HTML}{16213e}
\definecolor{hb@red}{HTML}{e94560}
\definecolor{hb@green}{HTML}{2e7d32}
\definecolor{hb@warn}{HTML}{c62828}
\definecolor{hb@orange}{HTML}{e65100}
\definecolor{hb@lightgray}{HTML}{f5f5f5}
\definecolor{hb@darkgray}{HTML}{616161}
% Rückwärtskompatibilität
\colorlet{darkblue}{hb@blue}
\colorlet{accentred}{hb@red}
\colorlet{keygreen}{hb@green}
\colorlet{warnred}{hb@warn}
\colorlet{warnorange}{hb@orange}
\colorlet{lightgray}{hb@lightgray}

% ============================================================
% Schriftgrößen angepasst auf 6×9 (kleinere Seite)
% ============================================================
\RequirePackage{titlesec}

\titleformat{\section}
  {\large\bfseries\color{hb@blue}}
  {Kapitel~\thesection:}{0.5em}{}
\titleformat{\subsection}
  {\normalsize\bfseries\color{hb@blue!80}}
  {}{0em}{}
\titleformat{\subsubsection}
  {\small\bfseries\color{hb@darkgray}}
  {}{0em}{}

\titlespacing*{\section}{0pt}{8pt}{3pt}
\titlespacing*{\subsection}{0pt}{5pt}{2pt}
\titlespacing*{\subsubsection}{0pt}{4pt}{1pt}

% ============================================================
% Kopf- und Fußzeile
% ============================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\fancypagestyle{firstpage}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\small\color{hb@darkgray}\hbfoottext}
}

% ============================================================
% Titelblock
% ============================================================
\newcommand{\hbmaketitle}{%
  \thispagestyle{firstpage}%
  \begin{center}
    {\small\color{hb@darkgray} Dok.~\hbdoknr}\\[3pt]
    {\Large\bfseries\color{hb@blue} \hbtitel}\\[5pt]
    {\normalsize\itshape\color{hb@darkgray} \hbuntertitel}\\[6pt]
    {\color{hb@red}\rule{0.6\linewidth}{1.5pt}}
  \end{center}
  \vspace{4pt}
}

% ============================================================
% Boxen
% ============================================================
\newtcolorbox{keybox}[1][]{%
  colback=hb@green!7, colframe=hb@green!55!black,
  boxrule=0.5pt, arc=2pt,
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  fontupper=\small, #1}

\newtcolorbox{warnbox}[1][]{%
  colback=hb@warn!7, colframe=hb@warn!60!black,
  boxrule=0.5pt, arc=2pt,
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  fontupper=\small, #1}

\newtcolorbox{hintbox}[1][]{%
  colback=hb@orange!7, colframe=hb@orange!55!black,
  boxrule=0.5pt, arc=2pt,
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  fontupper=\small, #1}

\newtcolorbox{infobox}[1][]{%
  colback=hb@lightgray, colframe=hb@darkgray!40,
  boxrule=0.4pt, arc=2pt,
  left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  fontupper=\small, #1}

% ── Hellblauer Tabellenkopf (automatisch) ─────────────────────────────
% Redefine \toprule to add light blue background for header row
\newcommand{\hbtoprule}{%
  \toprule
  \rowcolor{hb@headbg}%
}
% Instruction: use \hbtoprule instead of \toprule in all tables
